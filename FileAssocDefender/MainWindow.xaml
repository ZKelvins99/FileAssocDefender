<ui:FluentWindow x:Class="FileAssocDefender.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:FileAssocDefender.Views"
                 xmlns:converters="clr-namespace:FileAssocDefender.Converters"
                 Title="FileAssocDefender"
                 Width="1100"
                 Height="760"
                 MinWidth="960"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <converters:PageIndexToVisibilityConverter x:Key="PageVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:NavigationView Grid.Column="0"
                           Width="220"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="关联总览"
                                       Icon="{ui:SymbolIcon Home24}"
                                       Command="{Binding NavigateToOverviewCommand}" />
                <ui:NavigationViewItem Content="日志"
                                       Icon="{ui:SymbolIcon DocumentBulletList24}"
                                       Command="{Binding NavigateToLogsCommand}" />
                <ui:NavigationViewItem Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Command="{Binding NavigateToSettingsCommand}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <Grid Grid.Column="1">
            <views:AssociationListView DataContext="{Binding AssociationList}"
                                       Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=0}" />
            <views:LogView DataContext="{Binding Log}"
                           Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=1}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=2}" />
        </Grid>

        <views:DetailDrawer Grid.ColumnSpan="2"
                            Panel.ZIndex="100"
                            DataContext="{Binding DetailDrawer}"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolVisibility}}" />
    </Grid>
</ui:FluentWindow>
