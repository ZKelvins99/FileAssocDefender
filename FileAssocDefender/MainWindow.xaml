<ui:FluentWindow x:Class="FileAssocDefender.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:FileAssocDefender.Views"
                 xmlns:converters="clr-namespace:FileAssocDefender.Converters"
                 Title="FileAssocDefender"
                 Width="1100"
                 Height="760"
                 MinWidth="960"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <converters:PageIndexToVisibilityConverter x:Key="PageVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="FileAssocDefender"
                     ShowClose="True"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView Grid.Column="0"
                               OpenPaneLength="220"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="关联总览"
                                           Icon="{ui:SymbolIcon Home24}"
                                           Command="{Binding NavigateToOverviewCommand}" />
                    <ui:NavigationViewItem Content="日志"
                                           Icon="{ui:SymbolIcon DocumentBulletList24}"
                                           Command="{Binding NavigateToLogsCommand}" />
                    <ui:NavigationViewItem Content="设置"
                                           Icon="{ui:SymbolIcon Settings24}"
                                           Command="{Binding NavigateToSettingsCommand}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <!-- 绑定 SelectedPageIndex 的容器继承 MainViewModel，避免子页 DataContext 覆盖导致三页叠在一起 -->
            <Grid Grid.Column="1">
                <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                    <views:AssociationListView DataContext="{Binding AssociationList}" />
                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                    <views:LogView DataContext="{Binding Log}" />
                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Grid>
            </Grid>
        </Grid>

        <views:DetailDrawer Grid.RowSpan="2"
                            Panel.ZIndex="100"
                            DataContext="{Binding DetailDrawer}"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolVisibility}}"
                            IsHitTestVisible="{Binding IsOpen}" />
    </Grid>
</ui:FluentWindow>
