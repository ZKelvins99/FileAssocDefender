<UserControl x:Class="FileAssocDefender.Views.AssociationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FileAssocDefender.Converters"
             xmlns:models="clr-namespace:FileAssocDefender.Models"
             Margin="0,0,0,12">
    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:StatusToTextConverter x:Key="StatusToText" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisible" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
    </UserControl.Resources>

    <Border Background="#1FFFFFFF"
            BorderBrush="#33000000"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#33000000" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:AssociationStatus.Hijacked}">
                        <Setter Property="BorderBrush" Value="#C42B1C" />
                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:AssociationStatus.Healthy}">
                        <Setter Property="BorderBrush" Value="#107C10" />
                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding FileTypeLabel}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Extension, StringFormat=' ({0})'}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                               Foreground="White"
                               FontSize="12" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="当前默认" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{Binding CurrentIcon}"
                           Width="24"
                           Height="24"
                           Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CurrentAppName}"
                               VerticalAlignment="Center"
                               FontSize="14" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentExePath}"
                           Opacity="0.65"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsHijacked, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="修复目标" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding TargetIcon}"
                           Width="24"
                           Height="24"
                           Margin="0,0,8,0" />
                    <TextBlock Text="{Binding TargetAppName}"
                               VerticalAlignment="Center"
                               FontSize="14" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Opacity="0.8"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsHijacked, Converter={StaticResource InverseBoolToVisible}}" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="修复为 Office"
                        Command="{Binding FixCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsHijacked, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
