<UserControl x:Class="FileAssocDefender.Views.AssociationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FileAssocDefender.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1FFFFFFF"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="文件关联总览"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Opacity="0.75">
                        <Run Text="正常 " />
                        <Run Text="{Binding HealthyCount}" FontWeight="SemiBold" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalCount}" FontWeight="SemiBold" />
                        <Run Text="  ·  上次扫描 " />
                        <Run Text="{Binding LastScanTime}" />
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="立即刷新"
                        Command="{Binding RefreshCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0" />

                <Button Grid.Column="2"
                        Content="一键全部修复为 Office"
                        Command="{Binding FixAllCommand}"
                        Padding="16,8"
                        FontWeight="SemiBold" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:AssociationCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
