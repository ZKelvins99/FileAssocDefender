<UserControl x:Class="FileAssocDefender.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720">
            <TextBlock Text="设置"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <Border Background="#1FFFFFFF"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="守护选项" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox Content="发现劫持时自动修复"
                              IsChecked="{Binding AutoRepair}"
                              Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="巡检间隔（秒）" VerticalAlignment="Center" Width="140" />
                        <TextBox Text="{Binding PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" />
                    </StackPanel>
                    <CheckBox Content="开机启动"
                              IsChecked="{Binding StartWithWindows}" />
                </StackPanel>
            </Border>

            <Border Background="#1FFFFFFF"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="本机 Microsoft Office" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding OfficeSummary}"
                               TextWrapping="Wrap"
                               Opacity="0.85" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
